# Copie este arquivo para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings > API Keys). Nunca envie o .env.local para o GitHub.

# Endereço do projeto, ex.: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (publishable, começa com sb_publishable_; em projetos antigos, a "anon key").
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (começa com sb_secret_; em projetos antigos, a "service_role key").
# Usada só no servidor, para verificar adesivo QR + PIN. Nunca exponha no navegador.
SUPABASE_SECRET_KEY=

# Chave do Resend (resend.com > API Keys), para os avisos por e-mail. Só no servidor.
RESEND_API_KEY=

# Remetente dos e-mails. Deixe vazio até ter um domínio verificado no Resend
# (até lá, os e-mails saem de onboarding@resend.dev e só chegam ao dono da conta).
EMAIL_REMETENTE=

# Chave do agendador de prazos (gerada no .env.local; copie também para a Vercel).
CRON_SECRET=
